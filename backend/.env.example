# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# --- Firebase Admin SDK -------------------------------------------------
# The Database & Infrastructure engineer owns the Firebase project, auth
# config and Firestore security rules. Ask them for a service-account key
# for local backend development, or use `firebase emulators:start` and
# point FIREBASE_EMULATOR_HOST at it instead.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=krishka-vachana
FIREBASE_EMULATOR_HOST=

# If no service account / emulator is available yet, the API falls back to
# an in-memory store and a mock auth dependency so backend work can proceed
# independently. See app/core/firebase.py and app/repositories/memory.py.
ALLOW_DEV_AUTH_FALLBACK=true

# Full Google Secret Manager version resource for a unique 32+ byte key.
# The key must remain stable so existing Aadhaar fingerprints can be matched.
AADHAAR_HMAC_SECRET_NAME=projects/PROJECT_ID/secrets/aadhaar-hmac-key/versions/latest

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- SMS gateway (OTP / notifications - backend-owned) --------------------
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BASE_URL=

# --- API -------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# --- Deployment / docs ------------------------------------------------------
APP_VERSION=0.1.0
# Set to false in production if you don't want /docs, /redoc and
# /openapi.json publicly exposed.
ENABLE_DOCS=true
